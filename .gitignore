# ============================================
# Adaptense — .gitignore
# ============================================

# === Unity auto-generated (regenerated on open) ===
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Cc]ode[Cc]overage/
*.csproj
*.sln
*.unitypackage

# === IDE / OS ===
.nuget/
.vscode/
.vs/
.DS_Store
.python-version
Thumbs.db

# === Native binaries (blanket ignore, then whitelist MediaPipe) ===
*.aar
*.bc
*.dll
*.dylib
*.so
**/*.framework/*
!**/*.framework/*.meta

# Whitelist MediaPipe Windows plugin (required for runtime)
!Packages/com.github.homuler.mediapipe/Runtime/Plugins/mediapipe_c.dll

# === Bazel / C++ build tooling (not needed at runtime) ===
bazel-*
/mediapipe_api/
/docker/
/third_party/
/WORKSPACE
/build.py
/.bazelrc
/.bazelversion
/.clang-format
/.versionrc
/issue-template-version-updater.js
/packages.config
/omnisharp.json

# === Original repo CI/CD ===
/.github/

# === StreamingAssets: ignore everything, then whitelist hand tracking models ===
Assets/StreamingAssets/*
!Assets/StreamingAssets/hand_landmark_full.bytes
!Assets/StreamingAssets/hand_landmark_full.bytes.meta
!Assets/StreamingAssets/hand_landmark_lite.bytes
!Assets/StreamingAssets/hand_landmark_lite.bytes.meta
!Assets/StreamingAssets/hand_recrop.bytes
!Assets/StreamingAssets/hand_recrop.bytes.meta
!Assets/StreamingAssets/palm_detection_full.bytes
!Assets/StreamingAssets/palm_detection_full.bytes.meta
!Assets/StreamingAssets/palm_detection_lite.bytes
!Assets/StreamingAssets/palm_detection_lite.bytes.meta
!Assets/StreamingAssets/handedness.txt
!Assets/StreamingAssets/handedness.txt.meta

# === MediaPipe package: ignore generated/binary files ===
Packages/com.github.homuler.mediapipe/PackageResources/MediaPipe/*
!Packages/com.github.homuler.mediapipe/PackageResources/MediaPipe/*.meta
Packages/com.github.homuler.mediapipe/PackageResources/MediaPipe/object_detection_3d.bytes.meta
Packages/com.github.homuler.mediapipe/Runtime/Plugins/Protobuf/*.dll
Packages/com.github.homuler.mediapipe/Runtime/Scripts/Protobuf/**/*.cs

# === Ignore macOS/Linux native libs (keep only Windows DLL) ===
Packages/com.github.homuler.mediapipe/Runtime/Plugins/libmediapipe_c.dylib
Packages/com.github.homuler.mediapipe/Runtime/Plugins/libmediapipe_c.so

# === Original repo files not needed for Adaptense ===
/CHANGELOG.md
